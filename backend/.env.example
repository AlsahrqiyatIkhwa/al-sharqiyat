# ==== Database ====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/al_sharqiyat?schema=public"

# ==== Server ====
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"

# ==== Auth ====
# Access token: short-lived, sent as a Bearer header, never stored server-side.
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
# Refresh token: long-lived, stored as an httpOnly cookie + hashed in the DB
# for revocation. MUST be a different secret than JWT_SECRET.
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-secret"
JWT_REFRESH_EXPIRES_IN="30d"
# Used to sign the cookie-parser cookie jar (CSRF/refresh cookies).
COOKIE_SECRET="change-this-to-another-long-random-secret"

# ==== Login brute-force protection ====
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ==== Observability ====
# Leave empty to disable Sentry locally — errors just log to console/files instead.
SENTRY_DSN=""
LOG_LEVEL="info"

# ==== Caching ====
# TTL (seconds) for cached public GET responses (products, shipping zones).
CACHE_TTL_SECONDS=60

# ==== Admin bootstrap (used only by prisma/seed.ts) ====
# Do NOT commit a real username/password here — this file is a template
# only, meant to be copied to .env (which is gitignored). Generate a
# strong random password for the real .env, e.g.: openssl rand -base64 24
ADMIN_USERNAME="change-this-admin-username"
ADMIN_PASSWORD="change-this-to-a-long-random-password"

# ==== Uploads ====
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=5

# ==== File storage driver ====
# "local" (default) writes to UPLOAD_DIR on disk — fine for local dev, but
# Railway's filesystem does NOT persist across redeploys. Set to "s3" and
# fill in the values below (works with AWS S3 or any S3-compatible bucket
# such as Cloudflare R2 / Backblaze B2) before relying on uploads long-term.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Leave empty for real AWS S3. Set for S3-compatible providers, e.g.
# Cloudflare R2: "https://<account-id>.r2.cloudflarestorage.com"
S3_ENDPOINT=""
# Optional: public/CDN domain to serve images from instead of the raw
# bucket URL, e.g. "https://cdn.al-sharqiyat.com"
S3_PUBLIC_URL_BASE=""

# ==== WhatsApp (admin alert only — customer confirmation is sent manually by the admin) ====
ADMIN_WHATSAPP_NUMBER="962787706573"
ADMIN_PANEL_URL="http://localhost:3000/admin"
# WhatsApp Business Cloud API (Meta). Leave empty in dev — the service
# automatically falls back to logging the message instead of sending it.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v20.0"

# ==== Email (admin new-order notification) ====
# SMTP credentials for sending the new-order alert to the shop's inbox.
# Leave empty in dev — the service falls back to logging the email instead
# of sending it. For Gmail, SMTP_USER is the full address and SMTP_PASS
# must be a 16-character "App Password" (Google Account -> Security ->
# App Passwords), NOT the regular account password — Gmail rejects normal
# passwords for SMTP.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
ADMIN_NOTIFICATION_EMAIL="alsharqiyat.erbed@gmail.com"

# ==== Orange Money Jordan (only used for the ORANGE_MONEY full-payment method — Cash-on-Delivery has no deposit) ====
# Display-only merchant number shown to customers at checkout when they choose to pay
# the full amount via Orange Money. Admin verifies the transfer manually — no
# payment gateway API is called.
ORANGE_MONEY_MERCHANT_NUMBER="0787706573"
ORANGE_MONEY_MERCHANT_NAME="محمد الخليل النجار"

# ==== Manual Payment (Western Union / Bank Transfer) ====
# Shown to customers who choose "Manual Transfer" at checkout instead of Cash on Delivery.
# No online payment gateway is used anywhere in this app — these are just display strings.
MANUAL_PAYMENT_RECEIVER_NAME="Ahmad Al-Sharqi"
MANUAL_PAYMENT_COUNTRY="Jordan"
MANUAL_PAYMENT_INSTRUCTIONS="يرجى إرسال المبلغ عبر ويسترن يونيون إلى الاسم والدولة الظاهرين أعلاه، ثم إرسال صورة إيصال التحويل عبر واتساب مع رقم الطلب لتأكيد الشحن."
MANUAL_PAYMENT_BANK_DETAILS="Bank of Jordan - IBAN: JOxx xxxx xxxx xxxx xxxx xxxx"
